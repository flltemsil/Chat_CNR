{
  "entities": {
    "User": {
      "title": "User",
      "description": "System users and their metadata",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "name": { "type": "string", "description": "Display name" },
        "email": { "type": "string", "description": "Email address" },
        "role": { "type": "string", "enum": ["admin", "user"], "description": "User role" },
        "interests": {
          "type": "array",
          "items": { "type": "string" },
          "description": "User interests for personalization"
        },
        "bio": { "type": "string", "description": "Short bio" },
        "phone": { "type": "string", "description": "Contact phone number" },
        "lastLogin": { "type": "string", "format": "date-time", "description": "Last login timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp" },
        "isPro": { "type": "boolean", "description": "Whether user has active Pro access" },
        "proExpiresAt": { "type": "string", "format": "date-time", "description": "Pro subscription expiration timestamp" },
        "dailyVisits": { "type": "object", "description": "Map of date strings to visit counts e.g. {'2026-09-20': 4}" },
        "todayVisits": { "type": "integer", "description": "Visits recorded today" },
        "lastVisitDate": { "type": "string", "description": "Date string of last visit" },
        "totalVisits": { "type": "integer", "description": "Total visits across all days" },
        "notificationsEnabled": { "type": "boolean", "description": "Whether push notifications are enabled" },
        "lastMonthlyNotification": { "type": "string", "format": "date-time", "description": "Timestamp of last monthly notification received" }
      },
      "required": ["uid", "name", "email", "role"]
    },
    "AppNotification": {
      "title": "AppNotification",
      "description": "System and broadcast notifications for users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["monthly", "announcement", "system"] },
        "targetUid": { "type": "string", "description": "Target UID or 'all' for broadcast" },
        "senderEmail": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "message", "type", "createdAt"]
    },
    "ChatSession": {
      "title": "ChatSession",
      "description": "A chat conversation session",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "createdAt", "updatedAt"]
    },
    "Message": {
      "title": "Message",
      "description": "A single message in a session",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "model"] },
        "text": { "type": "string" },
        "imageUrl": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "role", "text", "timestamp"]
    },
    "Usage": {
      "title": "Usage",
      "description": "Daily usage limits tracking",
      "type": "object",
      "properties": {
        "messages": { "type": "integer", "description": "Number of messages sent today" },
        "images": { "type": "integer", "description": "Number of images generated today" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/users/{userId}/usage/{dateStr}": {
      "schema": "Usage",
      "description": "Daily usage tracking for a user"
    },
    "/users/{userId}/sessions/{sessionId}": {
      "schema": "ChatSession",
      "description": "Chat sessions for a user"
    },
    "/users/{userId}/sessions/{sessionId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Messages within a session"
    },
    "/broadcast_notifications/{notificationId}": {
      "schema": "AppNotification",
      "description": "Monthly and system broadcast notifications"
    }
  }
}
