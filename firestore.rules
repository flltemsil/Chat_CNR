rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId}
    // Fields:
    //   - uid: string (required) - Firebase Auth UID
    //   - name: string (required) - Display name
    //   - email: string (required) - Email address
    //   - role: string (required, enum: ['admin', 'user']) - User role
    //   - lastLogin: timestamp (optional)
    //
    // Collection: users/{userId}/sessions
    // Document ID: {sessionId}
    // Fields:
    //   - id: string (required)
    //   - userId: string (required)
    //   - title: string (required)
    //   - createdAt: timestamp (required)
    //   - updatedAt: timestamp (required)
    //
    // Collection: users/{userId}/sessions/{sessionId}/messages
    // Document ID: {messageId}
    // Fields:
    //   - id: string (required)
    //   - role: string (required, enum: ['user', 'model'])
    //   - text: string (required)
    //   - imageUrl: string (optional)
    //   - timestamp: timestamp (required)
    //
    // Collection: users/{userId}/usage/{dateStr}
    // Document ID: {dateStr} (YYYY-MM-DD)
    // Fields:
    //   - messages: number (optional)
    //   - images: number (optional)
    //   - updatedAt: timestamp (optional)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isBanned() {
      return isAuthenticated() && request.auth.token.email == "b4164370@gmail.com";
    }

    function isOwner(userId) {
      return isAuthenticated() && !isBanned() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && !isBanned() &&
        (request.auth.token.email == "dorukaliarslan20@gmail.com" ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'));
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function isValidEmail(email) {
      return email is string;
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'role']) &&
             data.keys().hasOnly(['uid', 'name', 'email', 'role', 'lastLogin', 'interests', 'bio', 'phone', 'updatedAt', 'isOnline', 'lastActive']) &&
             data.uid is string && data.uid.size() > 0 &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.email is string && isValidEmail(data.email) &&
             data.role in ['admin', 'user'] &&
             (!('interests' in data) || data.interests is list) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() < 500)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() < 20)) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp) &&
             (!('isOnline' in data) || data.isOnline is boolean) &&
             (!('lastActive' in data) || data.lastActive is timestamp);
    }

    function isValidSession(data) {
      return data.keys().hasOnly(['id', 'userId', 'title', 'createdAt', 'updatedAt']) &&
             data.id is string && data.userId is string &&
             data.title is string && data.title.size() < 200 &&
             data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['id', 'role', 'text', 'timestamp']) &&
             data.keys().hasOnly(['id', 'role', 'text', 'timestamp', 'imageUrl', 'sources']) &&
             data.id is string && data.role in ['user', 'model'] &&
             data.text is string && data.text.size() < 10000 &&
             data.timestamp is timestamp;
    }

    function isValidUsage(data) {
      return data.keys().hasOnly(['messages', 'images', 'updatedAt']) &&
             (!('messages' in data) || data.messages is number) &&
             (!('images' in data) || data.images is number) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      // Users can read any profile to see online status
      allow read: if isAuthenticated();
      
      // Create: user can create their own profile
      allow create: if isOwner(userId);
      
      // Update: user can update their own profile
      allow update: if isOwner(userId) || isAdmin();
    }

    match /users/{userId}/sessions/{sessionId} {
      allow read, write: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidSession(request.resource.data);
      allow update: if isOwner(userId) && isValidSession(request.resource.data);
    }

    match /users/{userId}/sessions/{sessionId}/messages/{messageId} {
      allow read, write: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidMessage(request.resource.data);
      allow update: if isOwner(userId) && isValidMessage(request.resource.data);
    }

    match /shared_sessions/{shareId} {
      allow read: if true;
      allow create: if isAuthenticated();
    }

    match /users/{userId}/usage/{dateStr} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) && isValidUsage(request.resource.data);
    }

    // Global access to all users (for the user list)
    match /users/{anyUser} {
      allow list: if isAuthenticated();
    }
  }
}
